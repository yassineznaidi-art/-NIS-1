# NIS App v0.1 Environment — copy to .env and fill
# PUBLIC vs SECRET separation: never commit real .env

# App
NIS_DEBUG=false
NIS_MEMORY_ENABLED=true
NIS_RESPONSE_STYLE=warm

# Model Provider: nis_core | mock | auto
# nis_core = real NIS Core (authority, no API key needed)
# mock = development fallback (clearly marked MOCK)
# auto = try nis_core, fallback to mock
MODEL_PROVIDER=nis_core

# If you later use real LLM provider, put keys here (server only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# Security
NIS_SECRET_KEY=change-me-to-random-32-chars

# Dense embeddings (NIS Core)
# Already configured via nis/config.py: USE_DENSE=false default, embedding_model=all-MiniLM-L6-v2
# Toggle via env or code: export NIS_USE_DENSE=true

# Server
HOST=0.0.0.0
PORT=8000
